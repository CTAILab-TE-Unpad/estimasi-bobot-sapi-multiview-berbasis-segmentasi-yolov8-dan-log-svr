# Cattle Weight Estimation API — Environment Variables
# Copy this file to .env and fill in any values you want to override.
# Prefix: CATTLE_ (e.g. CATTLE_LOG_LEVEL=DEBUG)
# Unset variables use the defaults defined in src/cattle_weight/settings.py

# ---- Model Configuration ----
# CATTLE_MODELS_DIR=models
# CATTLE_YOLO_SEG_MODEL=yolov8l-seg.pt
# CATTLE_YOLO_STICKER_MODEL=best_sticker.pt
# CATTLE_SVR_MODEL=svr_log_pipeline.joblib
# CATTLE_MODEL_METADATA=model_metadata.joblib

# ---- Server ----
# CATTLE_API_HOST=0.0.0.0
# CATTLE_API_PORT=8000
# CATTLE_LOG_LEVEL=INFO
